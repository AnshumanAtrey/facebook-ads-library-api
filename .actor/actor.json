{
    "actorSpecification": 1,
    "name": "facebook-ads-library-api",
    "title": "Facebook Ads Library Scraper API - Winning Ads & Scam Check",
    "description": "Scrape the Meta (Facebook and Instagram) Ad Library with no login or cookies: ads for any keyword or advertiser, days each ad has run, versions, text, button, landing page, images and videos. Also an advertiser lead list and a brand scam check. Pay per ad, no start fee.",
    "version": "1.0",
    "buildTag": "latest",
    "categories": [
        "SOCIAL_MEDIA",
        "LEAD_GENERATION",
        "MARKETING"
    ],
    "input": "./INPUT_SCHEMA.json",
    "dockerfile": "../Dockerfile",
    "readme": "../README.md",
    "minMemoryMbytes": 128,
    "maxMemoryMbytes": 1024,
    "output": "./output_schema.json",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Meta Ad Library ads",
            "description": "One row per ad (or per advertiser in the Advertiser list mode). The run summary is the OUTPUT record of the key-value store.",
            "views": {
                "overview": {
                    "title": "Ads",
                    "description": "One row per ad: advertiser, how long it has run, how many versions, the text, the button and where it sends people.",
                    "transformation": {
                        "fields": [
                            "adLibraryUrl",
                            "pageName",
                            "daysRunning",
                            "versions",
                            "adText",
                            "callToAction",
                            "landingDomain",
                            "platforms",
                            "startDate",
                            "isActive"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "adLibraryUrl": {
                                "label": "Ad (adLibraryUrl)",
                                "format": "link"
                            },
                            "pageName": {
                                "label": "Advertiser (pageName)",
                                "format": "text"
                            },
                            "daysRunning": {
                                "label": "Days live (daysRunning)",
                                "format": "number"
                            },
                            "versions": {
                                "label": "Variants (versions)",
                                "format": "number"
                            },
                            "adText": {
                                "label": "Ad text (adText)",
                                "format": "text"
