                            },
                            "platforms": {
                                "label": "Shown on (platforms)",
                                "format": "array"
                            },
                            "startDate": {
                                "label": "Started (startDate)",
                                "format": "date"
                            },
                            "isActive": {
                                "label": "Running now? (isActive)",
                                "format": "boolean"
                            }
                        }
                    }
                },
                "creatives": {
                    "title": "Creatives",
                    "description": "The creative of each ad: text, headline, button, landing page, image and video links (Meta's own URLs).",
