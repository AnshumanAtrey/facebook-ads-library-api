        },
        "maxAds": {
            "title": "Ads per search (maxAds)",
            "type": "integer",
            "editor": "number",
            "minimum": 1,
            "maximum": 5000,
            "default": 100,
            "prefill": 20,
            "description": "Set the most ads per search to save for each keyword or advertiser. For the Advertiser list, the number of ads read to find advertisers. Technical: per-search cap; a spending limit also stops the run cleanly."
        },
        "status": {
            "sectionCaption": "Filters",
            "title": "Ad status (status)",
            "type": "string",
            "editor": "select",
            "enum": [
                "active",
                "inactive",
                "all"
            ],
            "enumTitles": [
                "Active now (active)",
                "Stopped (inactive)",
                "Active and stopped (all)"
            ],
            "default": "active",
            "description": "Pick the ad status: only ads running now (the default), only ads that stopped, or both. Technical: active_status."
        },
        "adType": {
            "title": "Ad category (adType)",
            "type": "string",
            "editor": "select",
            "enum": [
                "all",
                "political",
                "housing",
                "employment",
                "credit"
            ],
            "enumTitles": [
                "All ads (all)",
                "Political and issue (political)",
                "Housing ads (housing)",
                "Job ads (employment)",
                "Credit and loan ads (credit)"
            ],
            "default": "all",
            "description": "Pick the ad category: all ads, or one of Meta's special categories. Political and issue ads carry spend and impressions ranges. Technical: ad_type."
        },
        "mediaType": {
            "title": "Media type (mediaType)",
            "type": "string",
            "editor": "select",
            "enum": [
                "all",
                "image",
                "video",
                "meme",
                "none"
            ],
            "enumTitles": [
                "Any media (all)",
                "Images (image)",
                "Videos (video)",
                "Memes (meme)",
                "Text only (none)"
            ],
            "default": "all",
            "description": "Pick the media type to keep: only ads with this kind of creative. Technical: media type, checked on the returned creatives."
        },
        "minDaysRunning": {
            "title": "Min days live (minDaysRunning)",
            "type": "integer",
            "editor": "number",
            "minimum": 0,
            "maximum": 3650,
            "default": 0,
            "description": "Keep only ads that have run at least this many days, for example 30. Ads that run for weeks are usually the ones that make money. Technical: days from delivery start to stop, or to today while active."
        },
        "exactPhrase": {
            "title": "Exact phrase (exactPhrase)",
            "type": "boolean",
            "editor": "checkbox",
            "default": false,
            "description": "Match the keywords as one exact phrase instead of any order. Technical: KEYWORD_EXACT_PHRASE."
        },
        "groupVersions": {
            "title": "Merge versions (groupVersions)",
            "type": "boolean",
            "editor": "checkbox",
            "default": false,
            "description": "Keep one ad per group of versions (Meta groups the A/B variants of one ad). The versions column still says how many there are. Technical: one row per collation_id."
        },
        "sortBy": {
            "title": "Order (sortBy)",
            "type": "string",
            "editor": "select",
            "enum": [
                "impressions",
                "relevance"
            ],
            "enumTitles": [
                "Most seen first (impressions)",
                "Best match first (relevance)"
            ],
            "default": "impressions",
            "description": "Pick the order the ads come in, which decides the ones you get when Ads per search stops the list. Technical: SORT_BY_TOTAL_IMPRESSIONS or relevancy."
        },
        "officialPages": {
            "sectionCaption": "Brand scam check",
            "title": "Official pages (officialPages)",
            "type": "array",
            "editor": "stringList",
            "example": [
                "https://www.facebook.com/nike"
            ],
            "description": "For the brand scam check: the brand's own Facebook pages, whose ads are skipped. Leave empty and the actor picks the pages whose name is the brand (listed in the run summary). Technical: page links, ids or names.",
            "default": []
        }
    }
}
