{
    "title": "Facebook Ads Library Scraper API",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "mode": {
            "title": "Report type (mode)",
            "type": "string",
            "editor": "select",
            "enum": [
                "ads",
                "pages",
                "advertisers",
                "impersonation"
            ],
            "enumTitles": [
                "Ads for keywords (ads)",
                "Ads of advertisers (pages)",
                "Advertiser list (advertisers)",
                "Brand scam check (impersonation)"
            ],
            "default": "ads",
            "description": "Pick the report type you want back. Ads for keywords: every ad that matches your words. Ads of advertisers: all ads of the Facebook pages you list. Advertiser list: the businesses advertising on your keywords right now, one row each (a lead list). Brand scam check: ads that use a brand name from pages that are not the brand's own."
        },
        "searchTerms": {
            "title": "Keywords (searchTerms)",
            "type": "array",
            "editor": "stringList",
            "prefill": [
                "running shoes"
            ],
            "example": [
                "running shoes",
                "protein powder"
            ],
            "description": "Type the keywords to search, one per line, for example running shoes. \"protein powder, creatine\" on one line counts as two. You can also paste an Ad Library search link: its keywords, country and filters are used. For the brand scam check, type the brand, for example Nike. Technical: Ad Library q, keyword search (unordered unless Exact phrase is on)."
        },
        "pages": {
            "title": "Advertisers (pages)",
            "type": "array",
            "editor": "stringList",
            "example": [
                "https://www.facebook.com/nike",
                "Gymshark"
            ],
            "description": "For Ads of advertisers: the Facebook pages to list, one per line. A page link, a page id or just the name works, for example https://www.facebook.com/nike or Gymshark. Technical: page link, numeric page id, or a name resolved through the Ad Library page search.",
            "default": []
        },
